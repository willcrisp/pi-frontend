node_modules/
dist/
# The Android build's web bundle. Generated, like dist/ — `npm run android:sync`
# builds it and copies it into android/app/src/main/assets/public (which
# Capacitor's own .gitignore excludes for the same reason). Run that before
# assembling an APK from a fresh checkout.
dist-mobile/

# Playwright run output (see playwright.config.js)
test-results/
playwright-report/

# Local env. `.env.example` is deliberately NOT matched — it is the documentation
# of what these files may contain, and is meant to be committed.
.env
.env.local
.env.*.local
