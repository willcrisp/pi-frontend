<?xml version="1.0" encoding="utf-8"?>
<!-- The adaptive icon's foreground: a ring with one radius struck out to a dot.
     Drawn inside the centre 72x72 of the 108x108 canvas, which is the only part
     an adaptive icon guarantees is visible — Android masks the rest to whatever
     shape the launcher uses, and crops further when the icon animates. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ring -->
    <path
        android:pathData="M54,30 a24,24 0 1,0 0.01,0 Z"
        android:strokeColor="#E8E8EA"
        android:strokeWidth="5"
        android:fillColor="#00000000" />

    <!-- the radius, out to the rim at 45 degrees -->
    <path
        android:pathData="M54,54 L71,37"
        android:strokeColor="#5B8CFF"
        android:strokeWidth="5"
        android:strokeLineCap="round" />

    <!-- the point on the circumference -->
    <path
        android:pathData="M71,37 m-6,0 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0 Z"
        android:fillColor="#5B8CFF" />
</vector>
